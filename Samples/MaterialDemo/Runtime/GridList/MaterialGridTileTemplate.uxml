<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <engine:VisualElement data-source-type="Sim.Faciem.Material.Samples.GridList.MaterialGridDemoItem, Sim.Faciem.Material.Samples" class="mat-demo-grid-tile-template">
        <engine:Label class="mat-demo-grid-tile-template__title">
            <Bindings>
                <engine:DataBinding property="text" data-source-path="Title" binding-mode="ToTarget" update-trigger="WhenDirty" />
            </Bindings>
        </engine:Label>
        <engine:Label class="mat-demo-grid-tile-template__supporting-text">
            <Bindings>
                <engine:DataBinding property="text" data-source-path="SupportingText" binding-mode="ToTarget" update-trigger="WhenDirty" />
            </Bindings>
        </engine:Label>
    </engine:VisualElement>
</engine:UXML>
