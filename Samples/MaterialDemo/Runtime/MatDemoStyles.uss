/*
 * MatDemoStyles.uss
 * Layout and typography styles for the Material Demo shell and nav panel.
 * Mat-button token colours are inherited from MatEditorStyles injected on
 * the window root — no additional @import needed here.
 */

/* ══ Shell root ═════════════════════════════════════════════════════════════ */
.mat-demo-root {
    flex-direction: row;
    flex-grow: 1;
}

/* ══ Left navigation panel ══════════════════════════════════════════════════ */
.mat-demo-nav-panel {
    width: 200px;
    flex-shrink: 0;
    flex-direction: column;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 8px;
    padding-right: 8px;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.12);
}

.mat-demo-nav-title {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    padding-left: 8px;
    padding-bottom: 8px;
    letter-spacing: 0.5px;
}

.mat-demo-nav-divider {
    height: 1px;
    background-color: rgba(0, 0, 0, 0.10);
    margin-bottom: 8px;
    margin-left: 4px;
    margin-right: 4px;
}

/* Nav buttons fill the panel width */
.mat-demo-nav-btn {
    width: 100%;
    height: 36px;
    margin-top: 2px;
    margin-bottom: 2px;
    -unity-text-align: middle-left;
    padding-left: 12px;
    border-radius: 4px;
}

/* ══ Content area (shared by all pages) ═════════════════════════════════════ */
.mat-demo-content {
    flex-grow: 1;
    padding: 24px;
    overflow: hidden scroll;
}

/* ══ Page typography ════════════════════════════════════════════════════════ */
.mat-demo-page-title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.mat-demo-page-subtitle {
    font-size: 13px;
    margin-bottom: 24px;
    opacity: 0.7;
}

.mat-demo-section-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-top: 24px;
    margin-bottom: 12px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.10);
}

.mat-demo-body {
    font-size: 13px;
    white-space: normal;
    margin-bottom: 12px;
}

/* ══ Pokédex card ════════════════════════════════════════════════════════════ */
.mat-demo-card-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 8px;
}

.mat-demo-card {
    width: 180px;
    padding: 16px;
    margin-right: 12px;
    margin-bottom: 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.12);
}

.mat-demo-card-number {
    font-size: 11px;
    opacity: 0.55;
    margin-bottom: 2px;
}

.mat-demo-card-name {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.mat-demo-card-type {
    font-size: 11px;
    margin-bottom: 8px;
    opacity: 0.75;
}

.mat-demo-card-desc {
    font-size: 11px;
    white-space: normal;
    opacity: 0.85;
}

/* ══ Button demo row ════════════════════════════════════════════════════════ */
.mat-demo-btn-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 12px;
}

.mat-demo-btn-row > .mat-button-base {
    margin-right: 8px;
    margin-bottom: 4px;
}

/* ══ Material list demo ══════════════════════════════════════════════════════ */
.mat-demo-list-control {
    height: 224px;
    margin-bottom: 12px;
}

.mat-demo-list-template {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.mat-demo-list-template__title {
    font-size: 14px;
    line-height: 20px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.mat-demo-list-template__supporting-text {
    font-size: 12px;
    line-height: 16px;
    color: var(--mat-list-item-supporting-text-color);
    white-space: normal;
}

/* ══ Material grid-list demo ═════════════════════════════════════════════════ */
.mat-demo-grid-list-control {
    height: 300px;
    margin-bottom: 12px;
}

.mat-demo-grid-list-control--short {
    height: 276px;
}

.mat-demo-grid-list-control--horizontal {
    height: 220px;
}

.mat-demo-grid-list-control--horizontal-short {
    height: 250px;
}

.mat-demo-grid-list-control--large {
    height: 420px;
}

.mat-demo-grid-tile-template {
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    padding: 12px;
}

.mat-demo-grid-tile-template__title {
    font-size: 14px;
    line-height: 20px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.mat-demo-grid-tile-template__supporting-text {
    font-size: 12px;
    line-height: 16px;
    white-space: normal;
    opacity: 0.82;
}

/* ══ Type chip (Theming page) ════════════════════════════════════════════════ */
.mat-demo-type-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 8px;
}

/* ══ Theme preview cards (Theming page) ══════════════════════════════════════ */
.mat-theme-preview-card {
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.2);
    padding: 16px;
    margin-bottom: 16px;
    /* Inherit the theme's surface text colour so all child labels are legible */
    color: var(--mat-button-on-surface);
}

.mat-theme-preview-card--dark  { background-color: #303030; }
.mat-theme-preview-card--light { background-color: #FAFAFA; }

.mat-theme-preview__name {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.mat-theme-preview__desc {
    font-size: 11px;
    opacity: 0.65;
    margin-bottom: 12px;
    white-space: normal;
}

/* ══ Input demo helpers ═════════════════════════════════════════════════════ */
.mat-demo-input-stack {
    flex-direction: column;
}

.mat-demo-input-stack > * {
    margin-bottom: 12px;
}

.mat-demo-output-label {
    margin-top: 8px;
}

/* ══ Icon demo ═══════════════════════════════════════════════════════════════ */
.mat-demo-icon-search-field {
    margin-bottom: 16px;
}

.mat-demo-icon-grid-list {
    height: 520px;
}

.mat-demo-icon-tile {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.18);
    padding: 12px;
    justify-content: space-between;
    background-color: rgba(128, 128, 128, 0.04);
}

.mat-demo-icon-tile__preview-frame {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.mat-demo-icon-tile__preview-image {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.mat-demo-icon-tile__file-name {
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}
