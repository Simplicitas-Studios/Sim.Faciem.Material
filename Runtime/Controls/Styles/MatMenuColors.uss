/*
 * MatMenuColors.uss
 * Default fallback CSS custom property definitions for MatMenu and MatMenuItem.
 */

:root {
    --mat-menu-trigger-text-color:                 var(--mat-button-on-surface, rgba(0, 0, 0, 0.87));
    --mat-menu-trigger-background:                 rgba(0, 0, 0, 0);
    --mat-menu-trigger-border-color:               rgba(0, 0, 0, 0.12);
    --mat-menu-trigger-hover-background:           var(--mat-button-hover-overlay, rgba(0, 0, 0, 0.04));
    --mat-menu-trigger-disabled-text-color:        var(--mat-button-disabled-color, rgba(0, 0, 0, 0.38));
    --mat-menu-trigger-disabled-border-color:      rgba(0, 0, 0, 0.08);
    --mat-menu-trigger-arrow-color:                rgba(0, 0, 0, 0.54);

    --mat-menu-panel-background:                   var(--mat-button-surface-bg, #FFFFFF);
    --mat-menu-panel-shadow:                       rgba(0, 0, 0, 0.2);

    --mat-menu-item-label-text-color:              var(--mat-button-on-surface, rgba(0, 0, 0, 0.87));
    --mat-menu-item-hover-state-layer-color:       rgba(0, 0, 0, 0.04);
    --mat-menu-item-active-state-layer-color:      rgba(0, 0, 0, 0.08);
    --mat-menu-item-disabled-label-text-color:     var(--mat-button-disabled-color, rgba(0, 0, 0, 0.38));
}
