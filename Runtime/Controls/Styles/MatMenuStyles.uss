/*
 * MatMenuStyles.uss
 * Structural and visual rules for MatMenu and MatMenuItem.
 */

@import url("./MatMenuColors.uss");

.mat-menu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.mat-menu__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--mat-menu-trigger-border-color);
    background-color: var(--mat-menu-trigger-background);
    cursor: link;
}

.mat-menu__trigger:hover {
    background-color: var(--mat-menu-trigger-hover-background);
}

.mat-menu__trigger-icon,
.mat-menu-item__icon {
    width: 18px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--mat-menu-trigger-text-color);
    flex-shrink: 0;
}

.mat-menu__trigger-icon {
    margin-right: 8px;
}

.mat-menu__trigger-text {
    color: var(--mat-menu-trigger-text-color);
    font-size: 14px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.mat-menu__trigger-arrow {
    margin-left: 8px;
    color: var(--mat-menu-trigger-arrow-color);
    font-size: 12px;
    -unity-text-align: middle-center;
    transition-property: rotate;
    transition-duration: 0.2s;
    transition-timing-function: ease;
    rotate: 0deg;
    transform-origin: center center;
}

.mat-menu--open .mat-menu__trigger-arrow {
    rotate: 180deg;
}

.mat-menu--icon-only .mat-menu__trigger {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 999px;
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 8px;
    justify-content: center;
}

.mat-menu--icon-only .mat-menu__trigger:hover {
    background-color: var(--mat-button-hover-overlay);
}

.mat-menu--icon-only .mat-menu__trigger:focus {
    background-color: var(--mat-button-focus-overlay);
}

.mat-menu--icon-only .mat-menu__trigger:active {
    background-color: var(--mat-button-active-overlay);
}

.mat-menu--icon-only .mat-menu__trigger-icon {
    margin-right: 0;
}

.mat-menu--disabled .mat-menu__trigger {
    cursor: arrow;
    border-color: var(--mat-menu-trigger-disabled-border-color);
}

.mat-menu--disabled.mat-menu--icon-only .mat-menu__trigger {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.mat-menu--disabled .mat-menu__trigger-text,
.mat-menu--disabled .mat-menu__trigger-arrow {
    color: var(--mat-menu-trigger-disabled-text-color);
}

.mat-menu--disabled .mat-menu__trigger-icon,
.mat-menu-item.mat-menu-item--disabled .mat-menu-item__icon {
    -unity-background-image-tint-color: var(--mat-menu-trigger-disabled-text-color);
}

.mat-menu__panel {
    background-color: var(--mat-menu-panel-background);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--mat-menu-panel-shadow);
    min-width: 160px;
    max-height: 320px;
    overflow: hidden;
}

.mat-menu-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(0, 0, 0, 0);
    cursor: link;
}

.mat-menu-item__icon {
    margin-right: 12px;
    -unity-background-image-tint-color: var(--mat-menu-item-label-text-color);
}

.mat-menu-item__text {
    flex-grow: 1;
    color: var(--mat-menu-item-label-text-color);
    font-size: 14px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.mat-menu-item.mat-menu-item--active {
    background-color: var(--mat-menu-item-hover-state-layer-color);
}

.mat-menu-item:active {
    background-color: var(--mat-menu-item-active-state-layer-color);
}

.mat-menu-item.mat-menu-item--disabled {
    cursor: arrow;
}

.mat-menu-item.mat-menu-item--disabled .mat-menu-item__text {
    color: var(--mat-menu-item-disabled-label-text-color);
}
