/*
 * MatPurpleGreenTheme.uss
 * Angular Material prebuilt theme: Purple / Green  (dark)
 *
 * Primary   — Purple 500   #9C27B0
 * Accent    — Green A200   #69F0AE
 * Warn      — Red 500      #F44336
 *
 * Variables are declared on both :root (panel-wide via PanelSettings .tss) and
 * .mat-theme--purple-green (scoped subtree usage).
 */

:root,
.mat-theme--purple-green {
    /* ── Primary ─────────────────────────────────────────────────────────── */
    --mat-button-primary-color:       #9C27B0;
    --mat-button-primary-ripple:      rgba(156, 39, 176, 0.2);
    --mat-button-primary-text-color:  #FFFFFF;

    /* ── Accent ──────────────────────────────────────────────────────────── */
    --mat-button-accent-color:        #69F0AE;
    --mat-button-accent-ripple:       rgba(105, 240, 174, 0.2);
    --mat-button-accent-text-color:   rgba(0, 0, 0, 0.87);

    /* ── Warn ────────────────────────────────────────────────────────────── */
    --mat-button-warn-color:          #F44336;
    --mat-button-warn-ripple:         rgba(244, 67, 54, 0.2);
    --mat-button-warn-text-color:     #FFFFFF;

    /* ── Disabled (dark surface) ─────────────────────────────────────────── */
    --mat-button-disabled-color:      rgba(255, 255, 255, 0.3);
    --mat-button-disabled-bg:         rgba(255, 255, 255, 0.12);

    /* ── Surface (dark) ──────────────────────────────────────────────────── */
    --mat-button-surface-bg:          #424242;
    --mat-button-on-surface:          rgba(255, 255, 255, 0.87);
    --mat-button-hover-overlay:       rgba(255, 255, 255, 0.08);
    --mat-button-focus-overlay:       rgba(255, 255, 255, 0.12);
    --mat-button-active-overlay:      rgba(255, 255, 255, 0.16);

    /* ── Stroked border (dark surface) ──────────────────────────────────── */
    --mat-button-stroked-border-color: rgba(255, 255, 255, 0.12);

    /* ── Raised / Flat hover backgrounds (base + MDC state layer) ───────── */
    --mat-button-surface-hover-bg:    #515151;  /* #424242 + 8% white  */
    --mat-button-surface-focus-bg:    #595959;  /* #424242 + 12% white */
    --mat-button-primary-hover-bg:    #A438B6;  /* #9C27B0 + 8% white  */
    --mat-button-primary-focus-bg:    #B45BC3;  /* #9C27B0 + 24% white */
    --mat-button-accent-hover-bg:     #61DDA0;  /* #69F0AE + 8% black  */
    --mat-button-accent-focus-bg:     #50B684;  /* #69F0AE + 24% black */
    --mat-button-warn-hover-bg:       #F55246;  /* #F44336 + 8% white  */
    --mat-button-warn-focus-bg:       #F77066;  /* #F44336 + 24% white */

    /* ── Form field (dark) ───────────────────────────────────────────────── */
    --mat-form-field-fill-background:           rgba(255, 255, 255, 0.1);
    --mat-form-field-fill-disabled-background:  rgba(255, 255, 255, 0.05);
    --mat-form-field-label-color:               rgba(255, 255, 255, 0.7);
    --mat-form-field-disabled-label-color:      rgba(255, 255, 255, 0.3);
    --mat-form-field-focus-color:               #9C27B0;
    --mat-form-field-underline-color:           rgba(255, 255, 255, 0.5);
    --mat-form-field-disabled-underline-color:  rgba(255, 255, 255, 0.3);
    --mat-form-field-outline-color:             rgba(255, 255, 255, 0.38);
    --mat-form-field-hover-outline-color:       rgba(255, 255, 255, 0.87);
    --mat-form-field-disabled-outline-color:    rgba(255, 255, 255, 0.1);
    --mat-form-field-hint-color:                rgba(255, 255, 255, 0.6);

    /* ── Select / Option (dark) ──────────────────────────────────────────── */
    --mat-select-trigger-text-color:                   rgba(255, 255, 255, 0.87);
    --mat-select-placeholder-text-color:               rgba(255, 255, 255, 0.42);
    --mat-select-disabled-trigger-text-color:          rgba(255, 255, 255, 0.3);
    --mat-select-arrow-color:                          rgba(255, 255, 255, 0.54);
    --mat-select-disabled-arrow-color:                 rgba(255, 255, 255, 0.3);
    --mat-select-panel-background:                     #424242;
    --mat-select-panel-shadow:                         rgba(0, 0, 0, 0.4);
    --mat-option-label-text-color:                     rgba(255, 255, 255, 0.87);
    --mat-option-hover-state-layer-color:              rgba(255, 255, 255, 0.08);
    --mat-option-focus-state-layer-color:              rgba(255, 255, 255, 0.16);
    --mat-option-selected-state-label-text-color:      #9C27B0;
    --mat-option-selected-state-layer-color:           rgba(156, 39, 176, 0.2);
    --mat-option-disabled-state-label-text-color:      rgba(255, 255, 255, 0.3);
    --mat-pseudo-checkbox-border-color:                rgba(255, 255, 255, 0.54);
    --mat-pseudo-checkbox-selected-background:         #9C27B0;
    --mat-pseudo-checkbox-selected-checkmark-color:    #FFFFFF;

    /* ── Menu (dark) ────────────────────────────────────────────────────── */
    --mat-menu-trigger-text-color:                     rgba(255, 255, 255, 0.87);
    --mat-menu-trigger-background:                     rgba(0, 0, 0, 0);
    --mat-menu-trigger-border-color:                   rgba(255, 255, 255, 0.12);
    --mat-menu-trigger-hover-background:               rgba(255, 255, 255, 0.08);
    --mat-menu-trigger-disabled-text-color:            rgba(255, 255, 255, 0.3);
    --mat-menu-trigger-disabled-border-color:          rgba(255, 255, 255, 0.08);
    --mat-menu-trigger-arrow-color:                    rgba(255, 255, 255, 0.54);
    --mat-menu-panel-background:                       #424242;
    --mat-menu-panel-shadow:                           rgba(0, 0, 0, 0.4);
    --mat-menu-item-label-text-color:                  rgba(255, 255, 255, 0.87);
    --mat-menu-item-hover-state-layer-color:           rgba(255, 255, 255, 0.08);
    --mat-menu-item-active-state-layer-color:          rgba(255, 255, 255, 0.12);
    --mat-menu-item-disabled-label-text-color:         rgba(255, 255, 255, 0.3);

    /* ── List (dark) ────────────────────────────────────────────────────── */
    --mat-list-background:                              #424242;
    --mat-list-outline-color:                           rgba(255, 255, 255, 0.12);
    --mat-list-divider-color:                           rgba(255, 255, 255, 0.08);
    --mat-list-item-label-text-color:                   rgba(255, 255, 255, 0.87);
    --mat-list-item-supporting-text-color:              rgba(255, 255, 255, 0.6);
    --mat-list-item-hover-state-layer-color:            rgba(255, 255, 255, 0.08);
    --mat-list-item-focus-state-layer-color:            rgba(255, 255, 255, 0.12);
    --mat-list-item-selected-state-layer-color:         rgba(156, 39, 176, 0.2);
    --mat-list-item-selected-hover-state-layer-color:   rgba(156, 39, 176, 0.28);
    --mat-list-item-selected-label-text-color:          #C86CD7;
    --mat-list-checkbox-border-color:                   rgba(255, 255, 255, 0.54);
    --mat-list-checkbox-selected-background:            #9C27B0;
    --mat-list-checkbox-selected-checkmark-color:       #FFFFFF;

    /* ── Grid list (dark) ──────────────────────────────────────────────── */
    --mat-grid-list-background:                         #424242;
    --mat-grid-list-outline-color:                      rgba(255, 255, 255, 0.12);
    --mat-grid-list-tile-background:                    rgba(156, 39, 176, 0.12);
    --mat-grid-list-tile-border-color:                  rgba(255, 255, 255, 0.08);
    --mat-grid-list-tile-label-text-color:              rgba(255, 255, 255, 0.87);
}
